{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "bkdevbuddy hook run lint --ide cursor"
      },
      {
        "command": "bkdevbuddy hook run scan-secrets --ide cursor"
      },
      {
        "command": "bkdevbuddy hook run redline --ide cursor"
      }
    ],
    "stop": [
      {
        "command": "bkdevbuddy hook run drift --ide cursor"
      }
    ]
  }
}
